# Configurações de API do LLM (Grok/Gemini) via OpenRouter ou Gemini Direct
OPENROUTER_API_KEY=sua-chave-do-openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash

# Opcional: Chave Direta da API do Gemini (caso queira usar sem OpenRouter)
GEMINI_API_KEY=sua-chave-direta-do-gemini

# Mocks e compatibilidade local (SQLite substitui Supabase remoto)
SUPABASE_URL=http://local-dummy
SUPABASE_ANON_KEY=dummy
SUPABASE_SERVICE_KEY=dummy
