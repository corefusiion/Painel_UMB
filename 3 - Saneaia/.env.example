# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SANEAIA (PROJETO 3)
# ==============================================================================
APP_ENV=development

# 1. API GOOGLE GEMINI DIRETA (Recomendado - Gratuito no Google AI Studio)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
# Exemplo: GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=

# 2. OU OPENROUTER (Opcional - caso utilize créditos pré-pagos ou outros modelos)
# Obtenha sua chave em: https://openrouter.ai/keys
# Exemplo: OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# (Abaixo: configurações locais legadas mantidas para compatibilidade interna)
SUPABASE_URL=http://local-dummy
SUPABASE_ANON_KEY=dummy
SUPABASE_SERVICE_KEY=dummy
